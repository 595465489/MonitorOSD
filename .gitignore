cpp/config.json
cpp/profiles.json
cpp/ddccache.json
cpp/ddccache.json.bak
cpp/log.txt
cpp/boot_dbg.txt
cpp/scan_*.txt
boot_dbg.txt
*.log

# ---------- 发布成品与内部打包脚本（不进源码仓库）----------
发布/
release/
publish/
*.zip
make_release.ps1

